---
// src/pages/index.astro → 사이트의 "/" 주소가 돼요.
// 파일을 src/pages/makers.astro 로 만들면 "/makers" 페이지가 자동으로 생겨요. (파일 = 주소)
import BaseLayout from '../layouts/BaseLayout.astro';
import Kangaroo from '../components/Kangaroo.astro';
import PriceTicket from '../components/PriceTicket.astro';
import RipenessScale from '../components/RipenessScale.astro';
import OriginCharts from '../components/OriginCharts.astro';
import MakerCard from '../components/MakerCard.astro';
import TmiBox from '../components/TmiBox.astro';
import PeekingKangaroo from '../components/PeekingKangaroo.astro';
import Ranking from '../components/Ranking.astro';
import makers from '../data/makers.json';
import price from '../data/price.json';
import production from '../data/production.json';
import imports from '../data/imports.json';

const anySample = price.isSample || production.isSample || imports.isSample;
---

<BaseLayout title="캥거루 대리의 바나나 연구소">
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="#top">바나나 연구소</a>
      <nav aria-label="섹션 이동">
        <a href="#ranking">랭킹</a>
        <a href="#price">시세</a>
        <a href="#origin">원산지</a>
        <a href="#makers">메이커</a>
        <a href="#tmi">TMI</a>
      </nav>
    </div>
  </header>

  <main class="wrap" id="top">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">KANGAROO DAERI · BANANA LAB</p>
        <h1>캥거루 대리의<br /><span class="hl">바나나</span> 연구소</h1>
        <p class="lede">
          회사에서 바나나만 찾는 캥거루 대리가 직접 운영합니다. 오늘 바나나가 얼마인지, 어디서 왔는지, 어느 회사 건지 전부 여기서 확인하세요.
        </p>
        <RipenessScale stage={6} />
      </div>
      <div class="hero-roo">
        <p class="hero-bubble" id="hero-bubble" hidden></p>
        <Kangaroo size={260} />
        <p class="whoami">오늘의 당신은 <strong id="my-name">…</strong></p>
        <button id="feed" class="feed-btn" type="button">대리님께 바나나 드리기</button>
        <p class="feed-count" id="my-stat">오늘 드린 바나나 0개</p>
        <a class="rank-link" id="rank-link" href="#ranking" aria-controls="ranking-body">랭킹 보기</a>
      </div>
    </section>

    <section class="section" id="ranking">
      <div class="section-head">
        <div>
          <p class="eyebrow">바나나 랭킹</p>
          <h2>오늘 누가 제일 많이 드렸나</h2>
        </div>
        <button class="fold-btn" id="rank-toggle" type="button" aria-expanded="false" aria-controls="ranking-body">
          <span id="rank-toggle-text">펼치기</span>
          <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <div id="ranking-body" hidden>
        <Ranking />
      </div>
    </section>

    <script is:inline>
      // 랭킹 접기/펼치기. 접속할 때마다 항상 접힌 상태로 시작해요.
      (function () {
        var body = document.getElementById('ranking-body');
        var btn = document.getElementById('rank-toggle');
        var label = document.getElementById('rank-toggle-text');
        var heroLink = document.getElementById('rank-link');
        function setOpen(open) {
          body.hidden = !open;
          btn.setAttribute('aria-expanded', String(open));
          label.textContent = open ? '접기' : '펼치기';
          heroLink.textContent = open ? '랭킹 접기' : '랭킹 보기';
          heroLink.setAttribute('aria-expanded', String(open));
        }
        setOpen(false);
        btn.addEventListener('click', function () { setOpen(body.hidden); });
        heroLink.addEventListener('click', function (e) {
          if (!body.hidden) { e.preventDefault(); setOpen(false); } else { setOpen(true); }
        });
        // 상단 메뉴의 '랭킹'은 항상 펼친 채로 이동
        document.querySelectorAll('nav a[href="#ranking"]').forEach(function (a) {
          a.addEventListener('click', function () { setOpen(true); });
        });
      })();
    </script>

    <section class="section" id="price">
      <div class="section-head">
        <div>
          <p class="eyebrow">오늘의 시세</p>
          <h2>바나나 {price.unit}에 얼마?</h2>
        </div>
      </div>
      <div class="price-grid">
        <PriceTicket />
        <div class="price-side">
          <p>서울 소매가 기준이에요. 평일 저녁마다 한국농수산식품유통공사(KAMIS) 데이터를 받아와서 자동으로 바뀌어요.</p>
          <p class="muted">{price.isSample ? '지금 숫자는 화면 확인용 예시예요. 첫 자동 수집이 끝나면 실제 값으로 바뀌어요.' : `출처: ${price.source}`}</p>
        </div>
      </div>
    </section>

    <section class="section" id="origin">
      <div class="section-head">
        <div>
          <p class="eyebrow">원산지와 생산량</p>
          <h2>바나나는 어디서 오나</h2>
        </div>
      </div>
      <OriginCharts />
    </section>

    <section class="section" id="makers">
      <div class="section-head">
        <div>
          <p class="eyebrow">메이커 도감</p>
          <h2>스티커 속 그 회사들</h2>
        </div>
      </div>
      <div class="maker-grid">
        {makers.map((m) => <MakerCard {...m} />)}
      </div>
    </section>

    <section class="section" id="tmi">
      <div class="section-head">
        <div>
          <p class="eyebrow">바나나 TMI</p>
          <h2>몰라도 되지만 알면 재밌는 것</h2>
        </div>
      </div>
      <TmiBox />
    </section>

    <footer class="footer">
      <p>캥거루 대리의 바나나 연구소</p>
      <ul class="sources">
        <li>시세: {price.source}</li>
        <li>생산량: {production.source}</li>
        <li>수입 원산지: {imports.source}</li>
      </ul>
      <p class="muted">
        {anySample ? '일부 숫자는 아직 예시예요. 실제 구매 판단에는 쓰지 마세요.' : '공공데이터를 가공해 보여줘요. 실제 매장 가격과는 다를 수 있어요.'}
      </p>
    </footer>
  </main>

  <PeekingKangaroo />
</BaseLayout>

<style>
  .topbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .topbar-inner {
    max-width: 1040px;
    margin-inline: auto;
    padding-inline: 20px;
    padding-block: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .brand { font-family: var(--font-display); font-size: var(--step-1); color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 4px 10px;
    border-radius: 999px;
  }
  nav a:hover { background: var(--peel); color: var(--on-peel); }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
    padding-block: 48px 8px;
  }
  .hero-text { display: grid; gap: 20px; min-width: 0; }
  h1 { font-size: var(--step-3); letter-spacing: -0.01em; }
  .hl {
    background: var(--peel);
    color: var(--on-peel);
    padding: 0 0.15em;
    border-radius: 0.15em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .lede { font-size: 1.0625rem; }
  .hero-roo { display: grid; justify-items: center; gap: 12px; }
  .feed-btn {
    padding: 10px 18px;
    background: var(--card);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--peel);
  }
  .feed-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--peel); }
  .feed-count { font-size: var(--step--1); color: var(--muted); }
  .whoami { font-size: 0.9375rem; text-align: center; }
  .whoami strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-1);
    padding: 0 0.3em;
    background: var(--peel);
    color: var(--on-peel);
    border-radius: 6px;
    white-space: nowrap;
  }
  .rank-link { font-size: var(--step--1); font-weight: 700; color: var(--stem); }
  .fold-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--card);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .fold-btn svg { width: 12px; height: 8px; transition: transform 0.2s; }
  .fold-btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  .hero-roo { position: relative; }
  .hero-bubble {
    position: absolute;
    top: 0;
    right: 0;
    max-width: 14em;
    padding: 8px 12px;
    background: var(--card);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 14px 14px 2px 14px;
    font-weight: 700;
    font-size: 0.875rem;
    z-index: 1;
  }
  .hero-bubble[hidden] { display: none; }

  .price-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  .price-side { display: grid; gap: 10px; min-width: 0; }
  .muted { color: var(--muted); font-size: var(--step--1); }

  .maker-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; }

  .footer {
    margin-top: 56px;
    padding-top: 20px;
    border-top: 2px solid var(--ink);
    display: grid;
    gap: 4px;
    font-size: var(--step--1);
  }
  .sources { margin: 0; padding-left: 1.1em; color: var(--muted); }

  @media (max-width: 720px) {
    .hero, .price-grid { grid-template-columns: minmax(0, 1fr); }
    .hero { padding-block: 32px 0; }
    .hero-roo { order: -1; }
    .hero-bubble { position: static; max-width: 100%; text-align: center; }
    .hero-roo :global(.roo) { width: 180px; }
  }
</style>
