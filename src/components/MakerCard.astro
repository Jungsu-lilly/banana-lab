---
// 바나나 메이커 도감 카드 한 장.
// 로고는 상표라 쓰지 않고, 이름은 바나나 스티커 모양 텍스트로만 표현해요.
interface Props {
  name: string;
  en: string;
  hq: string;
  origin: string;
  note: string;
}
const { name, en, hq, origin, note } = Astro.props;
---

<article class="maker">
  <div class="sticker">
    <span class="sticker-name">{name}</span>
    <span class="sticker-en">{en}</span>
  </div>
  <dl class="facts">
    <div><dt>본사</dt><dd>{hq}</dd></div>
    <div><dt>시작</dt><dd>{origin}</dd></div>
  </dl>
  <p class="note">{note}</p>
</article>

<style>
  .maker {
    display: grid;
    gap: 14px;
    align-content: start;
    padding: 20px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    min-width: 0;
  }
  .sticker {
    justify-self: start;
    display: grid;
    padding: 8px 18px;
    background: var(--peel);
    color: var(--on-peel);
    border: 2px solid var(--ink);
    border-radius: 999px;
    transform: rotate(-3deg);
    text-align: center;
  }
  .sticker-name { font-family: var(--font-display); font-size: var(--step-1); line-height: 1.1; }
  .sticker-en { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .facts { margin: 0; display: grid; gap: 4px; font-size: 0.9375rem; }
  .facts div { display: grid; grid-template-columns: 3em 1fr; gap: 8px; }
  .facts dt { color: var(--muted); font-weight: 700; }
  .facts dd { margin: 0; }
  .note { font-size: 0.9375rem; color: var(--muted); }
</style>
