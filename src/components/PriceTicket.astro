---
// 오늘의 바나나 시세 카드.
// 이 frontmatter(--- 사이) 코드는 "빌드할 때" 서버에서 한 번만 실행돼요.
// 그래서 스파크라인 좌표 계산을 여기서 끝내고, 브라우저엔 완성된 SVG만 보내요.
import price from '../data/price.json';

const history = price.history;
const latest = history[history.length - 1];
// 수집 첫날처럼 값이 하나뿐이면 비교와 그래프를 건너뛰어요
const prev = history.length > 1 ? history[history.length - 2] : null;
const diff = prev ? latest.price - prev.price : 0;
const diffPct = prev ? ((diff / prev.price) * 100).toFixed(1) : '0.0';

// 스파크라인 좌표 계산 (가로 0~280, 세로 8~72)
const W = 280;
const H = 80;
const prices = history.map((h) => h.price);
const min = Math.min(...prices);
const max = Math.max(...prices);
const pad = 8;
const pts = history.map((h, i) => {
  const x = (i / (history.length - 1)) * W;
  const y = pad + (1 - (h.price - min) / (max - min || 1)) * (H - pad * 2);
  return [x, y];
});
const line = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `0,${H} ${line} ${W},${H}`;
const [lastX, lastY] = pts[pts.length - 1];
const fmt = (d: string) => d.slice(5).replace('-', '.');
---

<div class="ticket">
  <div class="ticket-top">
    <span class="ticket-label">{price.item} · {price.unit}</span>
    {price.isSample && <span class="sample-badge">예시 데이터</span>}
  </div>
  <div class="ticket-price">
    <span class="num big">{latest.price.toLocaleString('ko-KR')}</span>
    <span class="won">원</span>
  </div>
  {prev && (
    <p class={`delta ${diff >= 0 ? 'up' : 'down'}`}>
      직전 조사일({fmt(prev.date)})보다 <span class="num">{diff >= 0 ? '+' : ''}{diff}원 ({diff >= 0 ? '+' : ''}{diffPct}%)</span>
    </p>
  )}
  {prev && <svg class="spark" viewBox={`0 0 ${W} ${H + 18}`} role="img" aria-label="최근 바나나 가격 추이">
    <line x1="0" x2={W} y1={pad} y2={pad} class="grid" />
    <line x1="0" x2={W} y1={H - pad} y2={H - pad} class="grid" />
    <polygon points={area} class="area" />
    <polyline points={line} class="line" />
    <circle cx={lastX} cy={lastY} r="5" class="dot" />
    <text x="0" y={H + 14} class="tick">{fmt(history[0].date)}</text>
    <text x={W} y={H + 14} text-anchor="end" class="tick">{fmt(latest.date)}</text>
  </svg>}
  <p class="ticket-foot">
    최근 {history.length}회 조사 · 최저 <span class="num">{min}</span>원 · 최고 <span class="num">{max}</span>원 · {fmt(latest.date)} 기준
  </p>
</div>

<style>
  .ticket {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 20px 22px 18px;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: 6px 6px 0 var(--peel);
  }
  .ticket-top { display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: center; }
  .ticket-label { font-size: var(--step--1); color: var(--muted); font-weight: 700; }
  .ticket-price { display: flex; align-items: baseline; gap: 4px; }
  .big { font-size: 3.25rem; line-height: 1; font-weight: 500; letter-spacing: -0.02em; }
  .won { font-family: var(--font-display); font-size: var(--step-1); }
  .delta { font-size: var(--step--1); font-weight: 700; }
  .delta.up { color: var(--stem); }
  .delta.down { color: var(--roo); }
  .spark { width: 100%; height: auto; }
  .spark .grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 3 4; }
  .spark .area { fill: var(--peel-soft); }
  .spark .line { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linejoin: round; }
  .spark .dot { fill: var(--peel); stroke: var(--ink); stroke-width: 2.5; }
  .spark .tick { fill: var(--muted); font-size: 11px; font-family: var(--font-mono); }
  .ticket-foot { font-size: var(--step--1); color: var(--muted); }
</style>
